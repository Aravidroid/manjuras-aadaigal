<!-- ══════════════════════════════════════
     CART SLIDE-OUT DRAWER
══════════════════════════════════════ -->
<div id="cart-drawer-panel" class="overlay-panel" role="dialog" aria-modal="true" aria-label="Shopping Cart">
  <div class="overlay-panel-backdrop" id="cart-drawer-backdrop"></div>
  
  <div class="slide-panel flex flex-col justify-between" id="cart-drawer">
    
    <!-- Drawer Header -->
    <div class="p-6 border-b border-[var(--color-cream-deeper)] flex items-center justify-between bg-[var(--color-offwhite)]">
      <div>
        <h3 class="font-display text-2xl text-[var(--color-text-primary)]">Shopping Bag</h3>
        <p class="font-body text-xs text-[var(--color-text-muted)] mt-0.5 tracking-wide">
          <span id="drawer-item-count">0</span> items
        </p>
      </div>
      <button id="cart-drawer-close" aria-label="Close cart" class="p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-maroon)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Free Delivery Notice -->
    <div id="drawer-shipping-bar" class="px-6 py-2.5 bg-[var(--color-cream-dark)] text-center text-xs font-body text-[var(--color-maroon)] font-medium border-b border-[var(--color-cream-deeper)]">
      <span>✦ Free delivery across India on orders above ₹999</span>
    </div>

    <!-- Items List -->
    <div id="drawer-items-list" class="flex-1 overflow-y-auto p-6 space-y-4">
      <!-- Items dynamically populated via JS -->
      <div id="drawer-empty-msg" class="text-center py-16 hidden">
        <svg class="mx-auto text-[var(--color-sandal)] mb-4" xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <p class="font-display text-xl text-[var(--color-text-primary)] mb-1">Your bag is empty</p>
        <p class="font-body text-xs text-[var(--color-text-muted)] mb-6">Discover our latest handwoven sarees and kurtis</p>
        <a href="/products" class="btn-primary" style="padding:0.6rem 1.5rem; font-size:0.75rem;">
          <span>Explore Collection</span>
        </a>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div id="drawer-footer-actions" class="p-6 border-t border-[var(--color-cream-deeper)] bg-[var(--color-offwhite)] space-y-3">
      <div class="flex items-center justify-between text-sm font-body">
        <span class="text-[var(--color-text-secondary)]">Subtotal</span>
        <span class="font-semibold text-lg text-[var(--color-maroon)]" id="drawer-subtotal">₹0</span>
      </div>
      <p class="text-[0.68rem] text-[var(--color-text-muted)] font-body">
        Taxes included. Delivery calculated at checkout.
      </p>

      <div class="pt-2 flex flex-col gap-2.5">
        <!-- Direct WhatsApp Order Button -->
        <a id="drawer-whatsapp-btn" href="/cart/whatsapp-checkout" class="w-full flex items-center justify-center gap-2.5 py-3 px-4 bg-[#25D366] text-white font-body text-xs font-semibold tracking-wider uppercase shadow-md hover:bg-[#1EBE5D] transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Order via WhatsApp</span>
        </a>

        <!-- View Cart Page Button -->
        <a href="/cart" class="btn-outline w-full text-center block text-xs tracking-wider" style="padding:0.75rem 1rem;">
          <span>View Cart & Details</span>
        </a>
      </div>
    </div>

  </div>
</div>
